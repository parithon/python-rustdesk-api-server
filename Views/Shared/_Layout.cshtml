<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RustDesk API Server</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .login-main {
            max-width: 400px;
            margin: 100px auto;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .btn-primary {
            width: 100%;
        }
        .form-control {
            margin-bottom: 15px;
        }
        .navbar-brand {
            font-weight: bold;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">RustDesk API Server</a>
            <div class="navbar-nav ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" href="/Home/Dashboard">Dashboard</a>
                    <a class="nav-link" href="/Home/Devices">Devices</a>
                    <a class="nav-link" href="/Home/Logout">Logout</a>
                }
                else
                {
                    <a class="nav-link" href="/Home/Login">Login</a>
                    <a class="nav-link" href="/Home/Register">Register</a>
                }
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>