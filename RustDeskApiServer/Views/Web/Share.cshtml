@using RustDeskApiServer.ViewModels
@model ShareViewModel
@{
    ViewData["Title"] = "Share Devices";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LegendName { Share Devices with Other Users }

<div class="layui-container">
    <div class="layui-card layui-col-md3-offset2">
        <div class="layui-card-header">Move devices you want to share to the right side</div>
        <div id="showdevice"></div>
        <button id="create" type="button" class="layui-btn padding-5" lay-on="getData">Generate Share Link</button>
    </div>
    <div class="layui-card">1. The link is valid for 15 minutes. Do not share it with strangers.</div>
    <div class="layui-card">2. Shared devices grant the same permissions as the owner. If a device has a saved password, the recipient can connect directly.</div>
    <div class="layui-card">3. For security, the link expires in 15 minutes and can only be used once. Once accessed by a non-owner logged-in user, the share takes effect and the link becomes invalid.</div>

    <div class="layui-card layui-col-md6-offset1">
        <table class="layui-table">
            <colgroup>
                <col width="30">
                <col width="150">
                <col width="200">
                <col>
            </colgroup>
            <thead>
            <tr>
                <th>Link</th>
                <th>Created At</th>
                <th>ID List</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var link in Model.ShareLinks)
            {
                <tr>
                    <td><script>document.write(window.location.origin + '/api/share/');</script>@link.SHash</td>
                    <td>@link.CreateTime</td>
                    <td>@link.Peers</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<script>
    layui.use(['transfer', 'jquery', 'layer'], function () {
        var transfer = layui.transfer;
        var $ = layui.jquery;
        var layer = layui.layer;

        transfer.render({
            elem: '#showdevice',
            title: ['My Devices', 'Share Devices'],
            data: [
                @foreach (var peer in Model.Peers)
                {
                    @Html.Raw($"{{\"value\": \"{peer.Value}\", \"title\": \"{peer.Title}\"}},")
                }
            ],
            id: 'device'
        });

        $("#create").click(function () {
            var getData = transfer.getData('device');
            $.ajax({
                url: '/api/share',
                type: 'post',
                dataType: 'json',
                data: {
                    data: JSON.stringify(getData),
                },
                success: function (data) {
                    if (data.code == 1) {
                        layer.alert('Success! Copy the following link to share with others:<br>' + window.location.origin + '/api/share/' + data.shash, function (index) {
                            location.reload();
                        });
                    } else {
                        layer.msg(data.msg);
                    }
                }
            });
        });
    });
</script>
