@using RustDeskApiServer.ViewModels
@model WorkViewModel
@{
    ViewData["Title"] = "RustDesk WebUI";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section LegendName { Dashboard }

<div style="padding: 20px; background-color: #F2F2F2;">
    <div class="layui-row layui-col-space15">

        @if (!Model.ShowAll)
        {
            <div class="layui-col-md15">
                <div class="layui-card">
                    <div class="layui-card-header">Device Statistics - [Username: @Model.User.UserName]</div>
                    <div class="layui-card-body">
                        <table class="layui-table">
                            <thead>
                            <tr>
                                <th>Client ID</th>
                                <th>Version</th>
                                <th>Has Password</th>
                                <th>System Username</th>
                                <th>Hostname</th>
                                <th>Alias</th>
                                <th>Platform</th>
                                <th>OS</th>
                                <th>CPU</th>
                                <th>Memory</th>
                                <th>IP</th>
                                <th>Registered</th>
                                <th>Updated</th>
                                <th>Status</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.RustDeskId</td>
                                    <td>@item.Version</td>
                                    <td>@item.HasRHash</td>
                                    <td>@item.Username</td>
                                    <td>@item.Hostname</td>
                                    <td>@item.Alias</td>
                                    <td>@item.Platform</td>
                                    <td>@item.Os</td>
                                    <td>@item.Cpu</td>
                                    <td>@item.Memory</td>
                                    <td>@item.IpAddress</td>
                                    <td>@item.CreateTime</td>
                                    <td>@item.UpdateTime</td>
                                    <td>@item.Status</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("_Pagination", (Model.PageNumber, Model.TotalPages, ""))
        }

        @if (Model.User.IsAdmin && Model.ShowAll)
        {
            <div class="layui-col-md15">
                <div class="layui-card">
                    <div class="layui-card-header">
                        All Users &raquo;
                        <div class="layui-btn"><a href="/api/down_peers">Export XLSX</a></div>
                    </div>
                    <div class="layui-card-body">
                        <table class="layui-table">
                            <thead>
                            <tr>
                                <th>Client ID</th>
                                <th>Belongs To</th>
                                <th>Version</th>
                                <th>System Username</th>
                                <th>Hostname</th>
                                <th>OS</th>
                                <th>CPU</th>
                                <th>Memory</th>
                                <th>IP</th>
                                <th>Registered</th>
                                <th>Updated</th>
                                <th>Status</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.RustDeskId</td>
                                    <td>@item.RustUser</td>
                                    <td>@item.Version</td>
                                    <td>@item.Username</td>
                                    <td>@item.Hostname</td>
                                    <td>@item.Os</td>
                                    <td>@item.Cpu</td>
                                    <td>@item.Memory</td>
                                    <td>@item.IpAddress</td>
                                    <td>@item.CreateTime</td>
                                    <td>@item.UpdateTime</td>
                                    <td>@item.Status</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("_Pagination", (Model.PageNumber, Model.TotalPages, "show_type=admin&"))
        }
    </div>
</div>
