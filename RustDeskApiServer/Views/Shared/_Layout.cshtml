<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - RustDesk Web</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link rel="stylesheet" href="~/layui/css/layui.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <script src="~/layui/layui.js"></script>
    <script>
        layui.use('element', function () {
            var element = layui.element;
            element.on('nav(demo)', function (elem) {
                layer.msg(elem.text());
            });
        });
    </script>

    <ul class="layui-nav">
        <li class="layui-nav-item"><a href="/">Home</a></li>
        @if (Model?.User?.IsAdmin == true)
        {
            <li class="layui-nav-item"><a href="/api/work?show_type=admin">All Devices</a></li>
        }
        <li class="layui-nav-item"><a href="/api/share">Share</a></li>
        <li class="layui-nav-item"><a href="/webui" target="_blank">Web Control</a></li>
        @if (Model?.User?.IsAdmin == true)
        {
            <li class="layui-nav-item">
                <a href="">Logs</a>
                <dl class="layui-nav-child">
                    <dd><a href="/api/conn_log">Connection Log</a></dd>
                    <dd><a href="/api/file_log">File Transfer Log</a></dd>
                </dl>
            </li>
        }
        <li class="layui-nav-item"><a href="/api/user_action?action=logout">Logout</a></li>
    </ul>

    <fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>@RenderSection("LegendName", required: false)</legend>
    </fieldset>

    @RenderBody()
</body>
</html>
