@page "/webui"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IConfiguration Config
@inject NavigationManager Nav

<PageTitle>Web Control — RustDesk</PageTitle>

<div style="position: fixed; top: 64px; left: 56px; right: 0; bottom: 0;">
    <iframe src="/webui-content"
            style="width:100%; height:100%; border:none;"
            title="RustDesk Web Client" />
</div>

@code {
    // The iframe loads /webui-content which is served as a minimal API
    // endpoint that injects the correct domain into the Flutter web client.
}
